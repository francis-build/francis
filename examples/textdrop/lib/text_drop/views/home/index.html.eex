        <%= if @deleted do %>
        <p class="notice" role="status">The document was deleted.</p>
        <% end %>
        <section>
            <h2>Open Any PDF File</h2>
            <p>Upload a document to read its metadata, browse its pages, draw areas to extract text from, and inspect every word and table on a page.</p>
            <form id="upload_form" action="/" method="post" enctype="multipart/form-data">
                <label for="pdf">Upload PDF File:</label>
                <input type="file" id="pdf" name="pdf" accept=".pdf,application/pdf" required>
                <br>
                <button type="submit">Open document</button>
            </form>
        </section>
